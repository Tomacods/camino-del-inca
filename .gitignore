# --- Propio del grupo ---
# Carpeta temporal del script de instalación
/_laravel_tmp
# Respaldos de la base: quedan en cada PC y en el Drive, no en el repositorio
/respaldos/*
!/respaldos/.gitkeep
# Base SQLite que crea Laravel por defecto (usamos PostgreSQL)
/database/*.sqlite

/.claude/settings.local.json
# Playwright CLI output (may contain credentials)
.playwright-cli/

# Skills de Claude Code: son solo de Tomás, no se suben al repo
/.claude/skills/
